{
  "name": "vite-federation",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "create-cli": "node packages/cli/dist/index.js",
    "storybook": "pnpm --filter @central-platform/ui storybook",
    "build-storybook": "pnpm --filter @central-platform/ui build-storybook",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm --filter @central-platform/ui build && changeset publish"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@central-platform/charts": "workspace:*",
    "antd": "6.5.0",
    "antd-mobile": "5.42.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.16.14",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.4.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.1"
  }
}
